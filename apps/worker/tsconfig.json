{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@studyhub/tsconfig/node.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false
  },

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
