{
  "name": "studyhub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-grade SaaS Learning Management Platform",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@studyhub/web",
    "dev:web": "npm run dev --workspace=@studyhub/web",
    "dev:admin": "npm run dev --workspace=@studyhub/admin",
    "dev:api": "npm run dev --workspace=@studyhub/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@studyhub/web",
    "build:admin": "npm run build --workspace=@studyhub/admin",
    "build:api": "npm run build --workspace=@studyhub/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "verify": "node scripts/verify.mjs",
    "precommit": "lint-staged",
    "commitlint": "commitlint --edit",
    "clean": "npm run clean --workspaces --if-present",
    "prepare": "husky || true"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{json,jsonc,md,mdx,css,scss,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.9.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
