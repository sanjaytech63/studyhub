# ============================================================
# StudyHub Web
# Next.js 16 Production Dockerfile
# ============================================================

FROM node:24-alpine AS base

WORKDIR /app

# ------------------------------------------------------------
# Dependency manifests
# ------------------------------------------------------------

COPY package.json package-lock.json ./

COPY apps/web/package.json ./apps/web/

COPY packages/config/package.json ./packages/config/
COPY packages/tsconfig/package.json ./packages/tsconfig/
COPY packages/types/package.json ./packages/types/
COPY packages/validation/package.json ./packages/validation/

# Root prepare script
COPY scripts ./scripts

RUN npm ci --include=dev


# ============================================================
# Build
# ============================================================

FROM base AS build

WORKDIR /app

COPY . .

ARG NEXT_PUBLIC_API_URL=https://api.studyhubonline.store/api/v1
ARG NEXT_PUBLIC_APP_URL=https://studyhubonline.store
ARG NEXT_PUBLIC_APP_NAME=StudyHub

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME

# Next.js production build
RUN npm run build --workspace=@studyhub/web


# ============================================================
# Runtime
# ============================================================

FROM node:24-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Next.js standalone server
COPY --from=build /app/apps/web/.next/standalone ./

# Static assets
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static

# Public assets
COPY --from=build /app/apps/web/public ./apps/web/public

EXPOSE 3000

CMD ["node", "apps/web/server.js"]