# ============================================================
# StudyHub Admin
# Next.js 16 Production Dockerfile
# ============================================================

FROM node:24-alpine AS base

WORKDIR /app

# ------------------------------------------------------------
# Dependency manifests
# ------------------------------------------------------------

COPY package.json package-lock.json ./

COPY apps/admin/package.json ./apps/admin/

COPY packages/config/package.json ./packages/config/
COPY packages/tsconfig/package.json ./packages/tsconfig/

# Root prepare script
COPY scripts ./scripts

RUN npm ci --include=dev


# ============================================================
# Build
# ============================================================

FROM base AS build

WORKDIR /app

COPY . .

ARG NEXT_PUBLIC_API_URL=https://api.studyhubonline.store
ARG NEXT_PUBLIC_APP_URL=https://admin.studyhubonline.store
ARG NEXT_PUBLIC_APP_NAME="StudyHub Admin"

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME

# Next.js production build
RUN npm run build --workspace=@studyhub/admin


# ============================================================
# Runtime
# ============================================================

FROM node:24-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME=0.0.0.0

# Next.js standalone server
COPY --from=build /app/apps/admin/.next/standalone ./

# Static assets
COPY --from=build /app/apps/admin/.next/static ./apps/admin/.next/static

# Public assets
COPY --from=build /app/apps/admin/public ./apps/admin/public

EXPOSE 3001

CMD ["node", "apps/admin/server.js"]
